---
import Layout from '../layouts/Layout.astro';
import YouTubeScreenshotAdvanced from '../components/YouTubeScreenshotAdvanced';
---

<Layout title="YouTube Screenshot Tool">
  <main class="min-h-screen bg-gray-50 py-8">
    <div class="container mx-auto px-4">
      <h1 class="text-3xl font-bold text-center mb-8 text-gray-800">
        YouTube Screenshot Tool
      </h1>
      <p class="text-center text-gray-600 mb-8 max-w-2xl mx-auto">
        Сделайте чистый скриншот YouTube видео без элементов управления. 
        Просто вставьте ссылку на видео и выберите момент для скриншота.
      </p>
      <YouTubeScreenshotAdvanced client:load />
    </div>
  </main>
</Layout>